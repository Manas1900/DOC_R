def quick_sort(a, low, high):
    if low < high:
        pivot = a[low]
        i = low + 1
        j = high
        while i <= j:
            while i <= high and a[i] <= pivot:
                i += 1
            while a[j] > pivot:
                j -= 1
            if i < j:
                a[i], a[j] = a[j], a[i]
        a[low], a[j] = a[j], a[low]
        quick_sort(a, low, j - 1)
        quick_sort(a, j + 1, high)
def selection_sort(a):
    n = len(a)
    for i in range(n):
        min_pos = i
        for j in range(i + 1, n):
            if a[j] < a[min_pos]:
                min_pos = j
        a[i], a[min_pos] = a[min_pos], a[i]
# main program
n = int(input("Enter number of students:"))
