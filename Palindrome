#include <iostream>
#include <stack>
#include <string>
using namespace std;
void reverseString(string str)
{
    stack<char> s;
    for (char ch : str)
    {
        s.push(ch);
    }
    cout << "Original String: " << str << endl;
    cout << "Reversed String: ";
    while (!s.empty())
    {
        cout << s.top();
        s.pop();
    }
    cout << endl;
}
void checkPalindrome(string str)
{
    stack<char> s;
    for (char ch : str)
    {
        s.push(ch);
    }
    bool isPalindrome = true;
    for (char ch : str)
    {
        if (ch != s.top())
        {
            isPalindrome = false;
            break;
        }
        s.pop();
    }
    if (isPalindrome)
        cout << str << " is a Palindrome." << endl;
    else
        cout << str << " is not a Palindrome." << endl;
}
int main()
{
    string str;
    cout << "Enter a string: ";
    getline(cin, str);
    reverseString(str);
    checkPalindrome(str);
    return 0;
}
